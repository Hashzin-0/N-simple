{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["gru1"],
  "functions": {
    "app/api/gemini/live-token/route.ts": {
      "maxDuration": 10
    },
    "app/api/gemini/pesquisador-fontes/route.ts": {
      "maxDuration": 300
    },
    "app/api/gemini/pesquisador-artigo/route.ts": {
      "maxDuration": 300
    },
    "app/api/gemini/redacao-pesquisa/route.ts": {
      "maxDuration": 300
    },
    "app/api/gemini/redacao-gerar/route.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
