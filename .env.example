GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENROUTER_API_KEY=
APP_URL=

# Supabase (server-side — sem NEXT_PUBLIC_*)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chave PRIVILEGIADA da pipeline semântica (escritas em sources/
# source_chunks/source_categories/source_topics/search_queries).
# Forma nova: Dashboard → Settings → API → JWT Signing Keys →
# SUPABASE_SECRET_KEYS (sb_secret_*). Legado: SUPABASE_SERVICE_ROLE_KEY.
# Sem ela as gravações semânticas caem para a publishable key e falham
# após supabase/migration-semantic-privileged-writes.sql (por design).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Google Sign-in
# Opcional: Client ID Web do Google. Se vazio, o servidor tenta ler
# external_google_client_id via Management API (SUPABASE_MANAGEMENT_TOKEN).
GOOGLE_CLIENT_ID=
# Opcional: PAT Supabase com escopo auth:read / auth_config_read
# (Management API GET /v1/projects/{ref}/config/auth)
SUPABASE_MANAGEMENT_TOKEN=

# Verificação de aluno ativo do CEFSA (gate do painel de admin)
# Moodle do Centro Educacional — Web Services já habilitados lá; só
# mudar se o host ou o service WS for outro. Opcional (tem default).
# CEFSA_MOODLE_URL=https://ead.cefsa.edu.br
# CEFSA_MOODLE_SERVICE=moodle_mobile_app

YOUTUBE_API_KEY=
# Opcional: chave da API do Semantic Scholar (1 RPS garantido, sai do pool
# anônima que responde 429 com frequência). Peça em
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
# Canais YouTube prioritários para busca de sinais Libras (handles com @,
# separados por vírgula). Busca primeiro neles; se não achar, fallback global.
LIBRAS_CHANNEL_HANDLES=@angelagirardi,@academiadelibras,@netolibras
# Orçamento de embeddings por chave (requests/min). DEVE ficar < 100 (free tier).
EMBEDDING_RPM_PER_KEY=80
EMBEDDING_CONCURRENCY=2
SCRAPER_CONCURRENCY=3
# Desabilita Chromium stealth (recomendado na Vercel — evita SIGKILL/OOM).
# Em Vercel o stealth já fica OFF por padrão; defina ENABLE_STEALTH=1 para forçar.
DISABLE_STEALTH=

# Inngest (FASE 2 do semântico — understandOne completo em 2º plano)
# Dev local: rode `npx inngest-cli@latest dev` e deixe INNGEST_DEV=1.
INNGEST_DEV=1
# Produção: event key + signing key do dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Segredo do Database Webhook do Supabase → POST /api/semantic/light-registered
# (rede de segurança para fontes 'light' gravadas fora da aplicação).
# Se vazio, o endpoint responde 503 e o webhook é ignorado.
# Caminho SQL: o MESMO valor vai em public.semantic_webhook_config.secret
# (não use ALTER DATABASE ... "app.settings.*" — exige superuser/42501).
SEMANTIC_WEBHOOK_SECRET=
