GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENROUTER_API_KEY=
APP_URL=

# Supabase (server-side — sem NEXT_PUBLIC_*)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google Sign-in
# Opcional: Client ID Web do Google. Se vazio, o servidor tenta ler
# external_google_client_id via Management API (SUPABASE_MANAGEMENT_TOKEN).
GOOGLE_CLIENT_ID=
# Opcional: PAT Supabase com escopo auth:read / auth_config_read
# (Management API GET /v1/projects/{ref}/config/auth)
SUPABASE_MANAGEMENT_TOKEN=

YOUTUBE_API_KEY=
# Orçamento de embeddings por chave (requests/min). DEVE ficar < 100 (free tier).
EMBEDDING_RPM_PER_KEY=80
EMBEDDING_CONCURRENCY=2
SCRAPER_CONCURRENCY=3
